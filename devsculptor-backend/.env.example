# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=devsculptor
DB_PASSWORD=devsculptor_secret
DB_NAME=devsculptor_db
DB_SSL=false

# Auth & MFA Security
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=8h
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security, Mailer & Network Proxy
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FRONTEND_URL=http://localhost:5173
MAIL_PROVIDER=console # Options: console | smtp
TRUST_PROXY_HOPS=1
ALLOW_CUSTOM_AI_ENDPOINTS=false
DEV_EXPOSE_RESET_TOKEN=false
AI_TIMEOUT_MS=45000

# AI Engine Configuration (Agnostic Provider Architecture)
AI_PROVIDER=gemini # Options: gemini | openai | deepseek | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
