{
  "name": "devsculptor-backend",
  "version": "1.0.0",
  "description": "Backend Core para DevSculptor - Monolito Modular MVC",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:assets": "node -e \"require('fs').cpSync('src/database','dist/database',{recursive:true,filter:s=>!s.endsWith('.ts')})\"",
    "build": "tsc && tsc-alias && npm run build:assets",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "seed": "tsx src/database/seeds/run-seed.ts",
    "bootstrap:superadmin": "tsx src/database/bootstrap-superadmin.ts",
    "benchmark:ai": "tsx scripts/run-ai-benchmark.ts"
  },
  "keywords": [
    "devsculptor",
    "backend",
    "express",
    "postgresql",
    "typescript"
  ],
  "author": "Nathaniel Muller San Martin",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
